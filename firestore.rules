rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // De scan die in dezelfde batch als deze puntenupdate wordt aangemaakt.
    function newScanFor(uid, scanId) {
      let path = /databases/$(database)/documents/scans/$(scanId);
      return scanId is string
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.uid == uid;
    }

    // Puntentotaal: enkel de eigen gebruiker, exact +10 per scan, samen met een
    // nieuw scan-document, en hoogstens één scan per 3 seconden.
    match /users/{uid} {
      allow read: if signedIn(uid);

      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['points', 'scans', 'updatedAt', 'lastScan'])
        && request.resource.data.points == 10
        && request.resource.data.scans == 1
        && request.resource.data.updatedAt == request.time
        && newScanFor(uid, request.resource.data.lastScan);

      allow update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['points', 'scans', 'updatedAt', 'lastScan'])
        && request.resource.data.points == resource.data.points + 10
        && request.resource.data.scans == resource.data.scans + 1
        && request.resource.data.updatedAt == request.time
        && request.time > resource.data.updatedAt + duration.value(3, 's')
        && newScanFor(uid, request.resource.data.lastScan);
    }

    // Scans: enkel aanmaken voor jezelf, met een geldig label en zekerheid >= 90%,
    // en alleen samen met de puntenupdate die naar deze scan verwijst.
    // Geen beelden of andere velden, geen wijzigen of verwijderen.
    match /scans/{scanId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'label', 'confidence', 'points', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.label in ['PMD', 'Papier/Karton', 'Restafval']
        && request.resource.data.confidence is number
        && request.resource.data.confidence >= 0.9
        && request.resource.data.confidence <= 1
        && request.resource.data.points == 10
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastScan == scanId;
      allow update, delete: if false;
    }
  }
}
